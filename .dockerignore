# ============================================
# .dockerignore - Build Optimization
# ============================================
# Excludes unnecessary files from Docker build context
# to reduce build time and image size.

# Node.js
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnpm-debug.log

# Build outputs
build
.svelte-kit
dist
.output
.vercel

# Development
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Environment files (will be provided at runtime)
.env
.env.*
!.env.example
!.env.docker

# Git
.git
.gitignore
.gitattributes
.github

# Testing
coverage
.nyc_output
playwright-report
test-results
*.test.ts
*.spec.ts
*.test.js
*.spec.js

# Documentation (will be included in release assets)
docs
*.md
!README.md

# CI/CD
.husky
.commitlintrc*
.prettierrc*
.eslintrc*
.editorconfig

# Database
*.db
*.sqlite
pgdata

# Logs
logs
*.log
pids
*.pid
*.seed
*.pid.lock

# Temporary files
tmp
temp
.tmp
.temp
*.tmp
*.temp

# SSL certificates (development)
certs

# IDE
.vscode
.idea
*.sublime-*

# OS
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride

# Docker
docker-compose*.yml
Dockerfile*
!Dockerfile

# Uploads (will be mounted as volume)
uploads

# SBOM generation (generated during build)
sbom/*.xml

# Scripts (except Docker scripts)
src/tools
scripts/*
!scripts/docker-*.sh
!scripts/docker-migrate.ts

# Playwright
playwright.config.ts
e2e

# Vitest
vitest*.ts

# Playwright browsers
.playwright
