# Konfiguration des Posteingang-Syncs auf dem Plesk-Server.
#
# Diese Datei ist die Vorlage. Die echte `config` liegt NUR auf dem Server
# (neben den Skripten) und gehört nicht ins Repo — sie nennt die
# Empfängeradresse der Störungsmeldungen.
#
# Nach jeder Änderung genügt das Speichern; der nächste Lauf zieht sie.

# Zielinstanz, an die POST /rest_sichtungen geht.
ZIEL_URL="https://dmm-prod-ostsee.ha.gecko.de"

# Datenverzeichnis des Posteingang-Dienstes (enthält posteingang/ und importiert/).
DATEN_DIR="/var/www/vhosts/schweinswalsichtung.de/legacy-inbox-data"

# Node-Laufzeit. Plesk liefert mehrere mit; gebraucht wird >= 18 wegen fetch.
NODE="/opt/plesk/node/24/bin/node"

# Verzeichnis der Werkzeuge im deployten Repo. Das Sync-Werkzeug kommt von
# dort, damit es mit dem Repo aktuell bleibt statt als Kopie zu driften.
REPO_TOOLS="/var/www/vhosts/schweinswalsichtung.de/repo/src/tools"

# Empfänger der Störungsmeldungen. Leeren, um den Versand abzuschalten.
MELDE_AN="name@example.org"
