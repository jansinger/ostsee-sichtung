{
	"name": "ostsee-tiere",
	"private": true,
	"version": "1.30.1",
	"description": "Ostsee-Tiere - Marine animal sighting reporting platform for the Baltic Sea",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --config eslint.config.js",
		"lint:fix": "eslint . --fix --config eslint.config.js",
		"lint:debug": "eslint . --config eslint.config.js --debug",
		"audit": "npm audit --audit-level=moderate",
		"type-check": "tsc --noEmit",
		"commit": "git-cz",
		"commit:signed": "git-cz -S",
		"release": "semantic-release",
		"release:dry-run": "semantic-release --dry-run",
		"test:unit": "vitest",
		"test:unit:watch": "vitest --watch",
		"test": "npm run test:quick",
		"test:quick": "npm run lint && npm run type-check && npm run check && npm run test:unit -- --run",
		"test:pr": "npm run lint && npm run type-check && npm run check && npm run test:unit -- --run",
		"test:e2e": "VITE_DEV_PORT=4001 playwright test",
		"db:start": "docker compose up -d",
		"db:stop": "docker compose down",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"generate:licenses": "node src/tools/generate-license-notices.js",
		"license:check": "license-checker --summary",
		"license:audit": "license-checker --onlyAllow 'MIT;ISC;BSD;Apache-2.0;Apache 2.0;BSD-2-Clause;BSD-3-Clause;CC0-1.0;Unlicense;WTFPL;0BSD;OFL-1.1;BlueOak-1.0.0;Python-2.0;MPL-2.0;Artistic-2.0;CC-BY-3.0;(MIT OR Apache-2.0);(MIT AND Zlib);(MIT OR CC0-1.0);(MIT AND CC-BY-3.0);(BSD-2-Clause OR MIT OR Apache-2.0);MIT AND BSD-3-Clause' --excludePrivatePackages",
		"db:fix-media-flags": "node src/tools/fix-media-upload-flags.js",
		"db:fix-media-flags:dry-run": "node src/tools/fix-media-upload-flags.js --dry-run",
		"db:fix-media-flags:verbose": "node src/tools/fix-media-upload-flags.js --verbose",
		"sbom:generate": "npm run sbom:json && npm run sbom:xml",
		"sbom:json": "npx @cyclonedx/cyclonedx-npm --ignore-npm-errors --output-format JSON --output-file sbom/sbom.json --validate",
		"sbom:xml": "npx @cyclonedx/cyclonedx-npm --ignore-npm-errors --output-format XML --output-file sbom/sbom.xml --validate",
		"sbom:prod": "npx @cyclonedx/cyclonedx-npm --ignore-npm-errors --omit dev --omit optional --output-format JSON --output-file sbom/sbom-prod.json --validate",
		"sbom:check": "node src/tools/check-sbom-vulnerabilities.js"
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"devDependencies": {
		"@apidevtools/swagger-parser": "^12.0.0",
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@cyclonedx/cyclonedx-npm": "^4.0.3",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.37.0",
		"@fontsource/roboto": "^5.2.8",
		"@iconify/json": "^2.2.392",
		"@playwright/test": "^1.56.0",
		"@scalar/api-reference": "^1.37.0",
		"@scalar/sveltekit": "^0.1.24",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^11.0.6",
		"@semantic-release/npm": "^12.0.2",
		"@sveltejs/adapter-vercel": "^5.10.3",
		"@sveltejs/kit": "^2.44.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.14",
		"@types/html-to-text": "^9.0.4",
		"@types/node": "^24.7.0",
		"@types/nodemailer": "^7.0.2",
		"@vitejs/plugin-basic-ssl": "^2.1.0",
		"@vitest/browser": "^3.2.4",
		"@vitest/coverage-v8": "^3.2.4",
		"commitizen": "^4.3.1",
		"cz-conventional-changelog": "^3.3.0",
		"daisyui": "^5.1.27",
		"dotenv": "^17.2.3",
		"drizzle-kit": "^0.31.5",
		"eslint": "^9.37.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"husky": "^9.1.7",
		"license-checker": "^25.0.1",
		"playwright": "^1.55.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"semantic-release": "^24.2.9",
		"svelte": "^5.39.9",
		"svelte-check": "^4.3.2",
		"tailwindcss": "^4.1.14",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.45.0",
		"unplugin-icons": "^22.4.2",
		"vite": "^7.1.9",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^3.2.4",
		"vitest-browser-svelte": "^1.1.0"
	},
	"dependencies": {
		"@paralleldrive/cuid2": "^2.2.2",
		"@turf/boolean-point-in-polygon": "^7.2.0",
		"@turf/helpers": "^7.2.0",
		"@vercel/blob": "^2.0.0",
		"drizzle-orm": "^0.44.6",
		"exifr": "^7.1.3",
		"handlebars": "^4.7.8",
		"html-to-text": "^9.0.5",
		"jsonwebtoken": "^9.0.2",
		"jwks-rsa": "^3.2.0",
		"nodemailer": "^7.0.7",
		"ol": "^10.6.1",
		"pino": "^10.0.0",
		"postgres": "^3.4.7",
		"rbush": "^4.0.1",
		"svelte-forms-lib": "^2.0.1",
		"tailwind-variants": "^3.1.1",
		"yup": "^1.7.1"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "4.52.4"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"esbuild": "^0.25.0"
	}
}
